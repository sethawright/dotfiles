#!/usr/bin/env python3
"""Save/restore portable Tinycast configuration through a private Git repo."""
import argparse
from contextlib import closing
import datetime
import json
import os
from pathlib import Path
import plistlib
import shutil
import sqlite3
import subprocess
import sys
import tempfile

DOMAIN = 'com.tinycast.app'
REMOTE = 'https://github.com/sethawright/dot-files-private.git'
SLUG = 'sethawright/dot-files-private'
HOME = Path.home()
REPO = Path(os.environ.get('DOTFILES_PRIVATE_DIR', HOME / 'work/dot-files-private')).expanduser()
SUPPORT = HOME / 'Library/Application Support' / DOMAIN
# Explicit allowlist: future credentials or consent flags cannot sneak into Git.
KEYS = set('''appearance appleShortcutsEnabled autoJoinConfirms boundAppBundleIDs
boundCustomCommandIDs boundCustomWindowSizeIDs boundQuickActionIDs boundQuicklinkIDs
boundWindowLayoutIDs boundWindowRoomIDs calculatorNumberStyle calendarIncludesTomorrow
calendarLauncherLimit calendarMenuBarDisplay calendarShowInLauncher clipboardDefaultAction
clipboardDisabledApps clipboardEnabled clipboardRetentionDays compactMode customCommands
customCommandsEnabled customCommandsShowInLauncher customWindowSizes emojiGridColumns
emojiSkinTone escapeKeyBehavior extensionsEnabled extensionsShowInLauncher favoriteApps
fileSearchEnabled fileSearchIgnorePatterns fileSearchScopes hiddenLauncherItems hiddenLauncherKinds
hideCurrentEvent hyperKeyIncludesShift hyperKeyPhysicalKey hyperKeyQuickPress interfaceSize
joinWindowMinutes launcherAliases launcherSearchScopes menuBarEvents menuBarLinkedEventsOnly
menuSearchDisabledApps menuSearchShowsAppleMenu navigationEnabled notesEnabled notesRendersMarkdown
notesShowsFormattingBar openOnCursorScreen paletteDraggable paletteTransparency popToRootTimeout
quicklinkConfirmsBeforeDelete quicklinkOpensNewWindow quicklinkSelectionFallback quicklinksEnabled
quicklinksShowInLauncher showFavoritesInCompactMode showInMenuBar snippetsShowInLauncher
supportReminders windowLayouts windowLayoutsShowInLauncher windowManagementCycleMode
windowManagementEnabled windowManagementGap windowManagementShowInLauncher windowRooms
windowRoomsShowInLauncher'''.split())
FILES = ['quicklinks.sqlite3', 'emoji-pinned.json', 'extension-commands.json',
         'extension-versions.json', 'extension-appearance.json', 'quick-actions.json']
DIRS = ['Snippets', 'extensions']


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def git(*args):
    return run('git', '-C', str(REPO), *args)


def private_repo():
    visibility = subprocess.check_output(['gh', 'repo', 'view', SLUG, '--json',
                                           'visibility', '--jq', '.visibility'], text=True).strip()
    if visibility != 'PRIVATE':
        raise RuntimeError('Refusing to use a repository that is not private.')
    if not REPO.exists():
        REPO.parent.mkdir(parents=True, exist_ok=True)
        run('git', 'clone', REMOTE, str(REPO))
    remote = subprocess.check_output(['git', '-C', str(REPO), 'remote', 'get-url', 'origin'], text=True).strip()
    if remote not in (REMOTE, 'git@github.com:' + SLUG + '.git'):
        raise RuntimeError('Private checkout has an unexpected origin.')
    dirty = subprocess.check_output(['git', '-C', str(REPO), 'status', '--porcelain'], text=True)
    if dirty.strip():
        raise RuntimeError('Private checkout has uncommitted changes; commit or stash them first.')
    git('fetch', 'origin')
    if subprocess.run(['git', '-C', str(REPO), 'rev-parse', '--verify', 'HEAD'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        git('pull', '--ff-only')


def stopped():
    if subprocess.run(['pgrep', '-x', 'Tinycast'], stdout=subprocess.DEVNULL).returncode == 0:
        raise RuntimeError('Quit Tinycast first, then run this command again. Reopen it afterward.')


def preferences():
    result = subprocess.run(['defaults', 'export', DOMAIN, '-'], capture_output=True)
    if result.returncode:
        if (HOME / 'Library/Preferences' / (DOMAIN + '.plist')).exists():
            raise RuntimeError('Could not export Tinycast preferences.')
        return {}
    return plistlib.loads(result.stdout)


def portable(prefs):
    return {k: v for k, v in prefs.items() if k in KEYS or k.startswith('hotkey.')}


def rehome(value, source, target):
    if isinstance(value, str):
        return value.replace(source + '/', target + '/')
    if isinstance(value, bytes):
        # Data-valued settings are often JSON encoded by Swift's Codable.
        try:
            return json.dumps(rehome(json.loads(value), source, target), separators=(',', ':')).encode()
        except (ValueError, UnicodeDecodeError):
            return value
    if isinstance(value, list):
        return [rehome(v, source, target) for v in value]
    if isinstance(value, dict):
        return {k: rehome(v, source, target) for k, v in value.items()}
    return value


def snapshot(destination, support, prefs, home):
    destination.mkdir(parents=True)
    (destination / 'preferences.plist').write_bytes(plistlib.dumps(portable(prefs)))
    (destination / 'manifest.json').write_text(json.dumps({'version': 1, 'source_home': str(home)}, indent=2) + '\n')
    for name in FILES:
        source = support / name
        if not source.exists():
            continue
        if name.endswith('.sqlite3'):
            with closing(sqlite3.connect(source.as_uri() + '?mode=ro', uri=True)) as src:
                with closing(sqlite3.connect(destination / name)) as dst:
                    src.backup(dst)
                    dst.execute('PRAGMA journal_mode=DELETE')
        else:
            shutil.copy2(source, destination / name)
    if (support / 'Snippets').exists():
        shutil.copytree(support / 'Snippets', destination / 'Snippets')
    extensions = support / 'extensions'
    if extensions.exists():
        for source in sorted(extensions.iterdir()):
            if not source.is_dir() or not (source / 'package.json').exists():
                continue
            manifest = json.loads((source / 'package.json').read_text())
            commands = [c['name'] + '.js' for c in manifest.get('commands', [])]
            if not any((source / c).is_file() for c in commands):
                raise RuntimeError('Unbuilt extension: ' + source.name)
            dest = destination / 'extensions' / source.name
            dest.mkdir(parents=True)
            shutil.copy2(source / 'package.json', dest / 'package.json')
            for command in commands:
                if '/' in command or '\\' in command:
                    raise RuntimeError('Unexpected extension command path.')
                if (source / command).is_file():
                    shutil.copy2(source / command, dest / command)
            if (source / 'assets').exists():
                shutil.copytree(source / 'assets', dest / 'assets')


def validate(source):
    manifest = json.loads((source / 'manifest.json').read_text())
    if manifest['version'] != 1:
        raise RuntimeError('Unsupported snapshot version.')
    prefs = plistlib.loads((source / 'preferences.plist').read_bytes())
    if set(prefs) != set(portable(prefs)):
        raise RuntimeError('Snapshot contains nonportable preference keys.')
    for path in source.rglob('*'):
        if path.is_symlink():
            raise RuntimeError('Snapshot contains a symlink.')
    db = source / 'quicklinks.sqlite3'
    if db.exists():
        with closing(sqlite3.connect(db.as_uri() + '?mode=ro&immutable=1', uri=True)) as conn:
            if conn.execute('PRAGMA integrity_check').fetchone()[0] != 'ok':
                raise RuntimeError('Quicklinks database failed integrity check.')
    for path in (source / 'extensions').glob('*/package.json'):
        package = json.loads(path.read_text())
        if not any((path.parent / (c['name'] + '.js')).is_file() for c in package['commands']):
            raise RuntimeError('Snapshot has an unbuilt extension.')
    return manifest, prefs


def save():
    if not SUPPORT.exists():
        raise RuntimeError('No Tinycast configuration found on this Mac.')
    with tempfile.TemporaryDirectory(dir=REPO) as temp:
        staged = Path(temp) / 'tinycast'
        snapshot(staged, SUPPORT, preferences(), HOME)
        validate(staged)
        target = REPO / 'tinycast'
        if target.exists():
            shutil.rmtree(target)
        shutil.move(str(staged), target)
    git('add', '--', 'tinycast')
    if subprocess.run(['git', '-C', str(REPO), 'diff', '--cached', '--quiet']).returncode == 0:
        git('push', '-u', 'origin', 'HEAD')
        print('Tinycast configuration is already saved.')
        return
    git('commit', '-q', '-m', 'Save Tinycast configuration')
    git('push', '-u', 'origin', 'HEAD')
    print('Tinycast configuration saved to the private repo.')


def restore():
    source = REPO / 'tinycast'
    manifest, saved = validate(source)
    current = preferences()
    merged = {k: v for k, v in current.items() if k not in KEYS and not k.startswith('hotkey.')}
    merged.update(rehome(saved, manifest['source_home'], str(HOME)))
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup = HOME / 'Library/Application Support/Tinycast-config-backups' / stamp
    backup.mkdir(parents=True)
    (backup / 'preferences.plist').write_bytes(plistlib.dumps(current))
    SUPPORT.mkdir(parents=True, exist_ok=True)
    for name in FILES + DIRS:
        target = SUPPORT / name
        if target.exists():
            shutil.move(str(target), backup / name)
        if (source / name).exists():
            if (source / name).is_dir():
                shutil.copytree(source / name, target)
            else:
                shutil.copy2(source / name, target)
    # Old WAL files must not be applied to the restored database.
    for suffix in ('-wal', '-shm'):
        path = SUPPORT / ('quicklinks.sqlite3' + suffix)
        if path.exists():
            shutil.move(str(path), backup / path.name)
    # Quicklinks can contain absolute paths; adapt only text values to this home.
    db = SUPPORT / 'quicklinks.sqlite3'
    if db.exists() and manifest['source_home'] != str(HOME):
        with sqlite3.connect(db) as conn:
            tables = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").fetchall()
            for (table,) in tables:
                quoted = '"' + table.replace('"', '""') + '"'
                for column in conn.execute('PRAGMA table_info(' + quoted + ')').fetchall():
                    field = '"' + column[1].replace('"', '""') + '"'
                    conn.execute('UPDATE ' + quoted + ' SET ' + field + '=replace(' + field + ', ?, ?) WHERE typeof(' + field + ")='text'",
                                 (manifest['source_home'] + '/', str(HOME) + '/'))
    with tempfile.NamedTemporaryFile(suffix='.plist') as temp:
        temp.write(plistlib.dumps(merged)); temp.flush()
        run('defaults', 'import', DOMAIN, temp.name, stdout=subprocess.DEVNULL)
    (SUPPORT / '.dotfiles-configured').write_text('Restored from ' + SLUG + '\n')
    print('Tinycast settings, snippets, quicklinks and extensions restored.')
    print('Previous configuration backed up at:', backup)
    print('Reopen Tinycast. Account sign-ins and macOS permissions stay per Mac.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['setup', 'save', 'restore'])
    action = parser.parse_args().action
    os.umask(0o077)
    if action == 'setup' and (SUPPORT / '.dotfiles-configured').exists():
        print('Tinycast already configured. Use tinycast-config restore to apply shared changes.')
        return
    stopped()
    private_repo()
    if action == 'save':
        save()
    else:
        restore()


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
        print('Tinycast setup:', error, file=sys.stderr)
        sys.exit(1)
