#!/usr/bin/env bash
# Open a project directory as a tmux session, here or on any Tailscale peer,
# creating the session with the editor/server/shell windows if it does not
# exist yet. Bound to M-/.
#
#   tmux-sessionizer            pick from the project directories everywhere
#   tmux-sessionizer <dir>      open a local directory without the picker

lib="$(dirname "${BASH_SOURCE[0]}")/lib"
# shellcheck source=lib/tmux-remote.sh
. "$lib/tmux-remote.sh"

# The same palette tmux-worktreeizer uses, so the two pickers match. Optional:
# without it fzf falls back to its own defaults and this still works.
colors=""
if [[ -r $lib/fzf-theme.sh ]]; then
  # shellcheck source=lib/fzf-theme.sh
  . "$lib/fzf-theme.sh"
  colors="$(fzf_theme_colors)"
fi

# sh rather than bash so it runs unchanged over ssh. Each machine looks in
# its own home, and directories it does not have are skipped.
find_projects='
for dir in ~/work ~/Code/work ~/Code/work/ctm/packages ~/Code/lrn ~/Code/seth ~/dotfiles; do
  [ -d "$dir" ] && find "$dir" -mindepth 1 -maxdepth 1 -type d -not -name ".*"
done
'

# Creates the session if it is missing, from "$1" (name) and "$2" (directory).
# sh for the same reason as find_projects, so the layout is defined once.
create_session='
tmux has-session -t="$1" 2>/dev/null && exit 0
tmux new-session -ds "$1" -c "$2" -n editor "nvim; exec fish"
tmux new-window -t "$1:" -c "$2" -n server
tmux new-window -t "$1:" -c "$2" -n shell
tmux select-window -t "$1:editor"
'

# The local projects first, then each peer's as it answers. fflush so awk
# passes rows on as they come instead of holding them until the slowest peer.
list_projects() {
  {
    sh -c "$find_projects" | sed 's/^/local	/'
    each_peer <<<"$find_projects"
  } | awk -F'\t' '{ printf "%-10s %s\n", $1, $2; fflush() }'
}

if [[ $# -eq 1 ]]; then
  host=local
  dir=$1
else
  # A process substitution, not a pipe, so a pick made before every peer has
  # answered is acted on at once rather than when bash reaps the pipeline.
  selected="$(
    fzf --reverse --prompt='open> ' --info=inline --pointer='>' \
      --height='100%' ${colors:+--color="$colors"} < <(list_projects)
  )" || exit 0
  [[ -n $selected ]] || exit 0
  host="${selected%% *}"
  dir="$(sed -E 's/^[^ ]+ +//' <<<"$selected")"
fi

name="$(basename "$dir" | tr . _)"

if [[ $host != local ]]; then
  remote_sh "$host" <<<"set -- '$name' '$dir'; $create_session" || exit 1
  attach_remote "$host" "$name"
  exit 0
fi

sh -c "$create_session" sh "$name" "$dir"

if [[ -n $TMUX ]]; then
  tmux switch-client -t "$name"
else
  tmux attach -t "$name"
fi
