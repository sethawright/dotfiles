#!/usr/bin/env bash

# The same palette tmux-worktreeizer uses, so the two pickers match. Optional:
# without it fzf falls back to its own defaults and this still works.
colors=""
theme="$(dirname "${BASH_SOURCE[0]}")/lib/fzf-theme.sh"
if [[ -r $theme ]]; then
  # shellcheck source=lib/fzf-theme.sh
  . "$theme"
  colors="$(fzf_theme_colors)"
fi

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/work ~/Code/work ~/Code/work/ctm/packages ~/Code/lrn ~/Code/seth ~/dotfiles -type d -mindepth 1 -maxdepth 1 -not -name '.*' |
    fzf --reverse --prompt='open> ' --info=inline --pointer='>' \
      --height='100%' ${colors:+--color="$colors"})
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  # Create new session with first window named "editor" and start nvim
  tmux new-session -s $selected_name -c $selected -n editor "nvim; exec fish"
  # Create second window named "server"
  tmux new-window -t $selected_name: -c $selected -n server
  # Create third window named "shell"
  tmux new-window -t $selected_name: -c $selected -n shell
  # Select the first window (editor)
  tmux select-window -t $selected_name:editor
  exit 0
fi

if ! tmux has-session -t=$selected_name 2>/dev/null; then
  # Create new detached session with first window named "editor" and start nvim
  tmux new-session -ds $selected_name -c $selected -n editor "nvim; exec fish"
  # Create second window named "server"
  tmux new-window -t $selected_name: -c $selected -n server
  # Create third window named "shell"
  tmux new-window -t $selected_name: -c $selected -n shell
  # Select the first window (editor)
  tmux select-window -t $selected_name:editor
fi

tmux switch-client -t $selected_name
