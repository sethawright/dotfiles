#!/usr/bin/env bash
#
# tmux-worktreeizer -- pick a git worktree and open a tmux session for it.
#
# Three modes, cycled with the backtick key:
#
#   repos       one row per repo. Enter opens that folder:
#
#                 ~/src/api             [master]   pushed   2 worktrees
#                 ~/src/web             [master]   pushed
#
#               enter on ~/src/api gives its own worktrees, and this is
#               the only place the create row lives:
#
#                 ~/src/api             [master]   pushed
#                 |- create new worktree (api)
#                 |- api/fix-timeouts   [fix-timeouts]  +2  PR #412 open
#
#   worktrees   every worktree in every repo, flattened into one list, with
#               no group headers and no create rows:
#
#                 api                   [master]   pushed
#                 api/fix-timeouts      [fix-timeouts]  +2  PR #412 open
#                 web/busy-gould        [(detached)]      detached  agent
#
#   envs        a name shared by worktrees in several repos is an env. Enter
#               shows what is in it:
#
#                 fix-timeouts   fix-timeouts.test  :20040  2 repos: api, web
#
#               Repos with no worktree of that name are not part of the env,
#               and callers fall back to their main checkout. Ports come from
#               the name itself, so nothing keeps a ledger of them.
#
#               tmux-worktreeizer --manifest writes the env list as JSON, for
#               a proxy to render a server block per env.
#
# ctrl-t creates a worktree in whichever repo the cursor is on, from either
# mode, so you never have to walk into a folder just to make one.
#
# Searching:
#   Type any part of a repo name to pull up that repo and everything in it.
#   Every row carries its repo name for this reason -- fzf can only match on
#   what it displays, so a bare worktree name would not be enough.
#
# Columns:
#   *          a tmux session is already open for this worktree
#   name       repo/worktree (the repo path itself on a group header)
#   [branch]   what is checked out, shown when it differs from the directory
#   status     see below
#   PR #n      from the cached pull request list, empty if nothing matched
#   tags       agent, live, locked, prunable, bare
#
# Status:
#   pushed     has an upstream and matches it
#   +2 / -1    commits ahead of / behind the upstream
#   no-remote  a branch with no upstream set, so nothing has been pushed
#   gone       had an upstream, but that remote branch is gone now
#   detached   not on a branch at all, just parked on a commit
#
# Tags:
#   agent      lives under .claude/worktrees or .codex/worktrees
#   live       an agent process has this worktree as its working directory
#   locked     git worktree lock was used, removal needs the force prompt
#   prunable   git thinks this one is stale and can be pruned
#
# Running things:
#   Creating a worktree runs the repo's setup hook in it.
#
#   Removing one runs the teardown hook, if there is one, to undo what setup
#   provisioned, such as dropping the env's own database. It runs after the
#   worktree is really gone, from the main checkout, and only for worktrees under
#   the worktree root, so an agent worktree never sets it off.
#
#   ctrl-space runs the repo in the session's server window, and stops it on a
#   second press. With a Procfile.dev (or Procfile) that means foreman over all
#   its entries in the one window, each line prefixed with the process name;
#   without one it means the run hook, else bin/debug.sh, bin/run.sh, bin/dev.sh.
#   A repo with none of those is skipped.
#
#   An app is rarely only its web process. Workers and schedulers belong in
#   the Procfile too: if an env has its own queues, the main checkout's workers
#   are looking somewhere else and would never pick up its jobs.
#
#   Worktrees in an env get that env's addresses, on the tmux session and in a
#   .env.worktree file the run command sources:
#
#     TW_ENV, TW_ENV_INDEX, TW_ENV_HOST, TW_PORT, PORT,
#     and TW_<REPO>_PORT / TW_<REPO>_HOST for every repo in the env
#
#   An env hook turns those into whatever the repo reads. See the README.
#
#   A service reads the peer it needs and falls back to the shared one when the
#   variable is absent. Ports are four apart, so a service can use those after
#   its own: a rails app may want three (web, debugger, control socket).
#
# Usage:
#   tmux-worktreeizer          the picker
#   tmux-worktreeizer --new    skip the picker, create a worktree in this repo
#   tmux-worktreeizer --manifest       write envs.json for a proxy to read
#   tmux-worktreeizer --env-exports E  print one env's variables
#
# Keys:
#   enter      in the repo list, open that folder; anywhere else, open (or
#              switch to) the tmux session, or start the create flow
#   `          cycle repos -> worktrees -> envs, or step back out of
#              whatever you opened
#   backspace  step out of a folder, once the query is empty. While there is
#              something typed it deletes characters as usual.
#   ctrl-t     create a worktree in the repo the cursor is on, run its setup,
#              and start it running if it has anything to run
#   ctrl-space start the repo run script in the session's server window, or
#              stop it if it is already going
#   tab        jump to the next repo, wrapping at the end
#   shift-tab  jump back to the previous repo
#   ctrl-x     remove the selected worktree and kill its tmux session, then
#              offer to delete the branch too (kept unless you say otherwise).
#              on an env row: the same, for every worktree in that env at
#              once, one confirmation instead of one per worktree
#   ctrl-d     close the tmux session only -- worktree and branch untouched.
#              No confirmation, same as ctrl-space.
#   ctrl-r     refresh the pull request cache for the selected repo
#   ctrl-s     git fetch --prune the selected repo
#   ctrl-o     open a browser: the pull request on a worktree row, the env's
#              host on an env row. No-op wherever neither applies.
#
# These stay off the keys fzf already uses to move and edit: ctrl-a b c e f g
# h i j l n p q u w y and ctrl-/. Two deliberate exceptions: tab, reused
# because its default (toggle+down) needs --multi, which this does not use;
# and ctrl-d, which really is fzf's delete-char/eof, used here anyway because
# it was the requested key. The cost: press it with a query typed and it
# closes a session instead of deleting a character.
#
# Environment:
#   TW_ROOT            where new worktrees go   (default ~/work/.worktrees)
#   TW_ROOTS           colon separated dirs scanned for repos
#   TW_REPOS           colon separated extra repo paths
#   TW_EDITOR          the editor window's command (default $EDITOR, then vi)
#   TW_BRANCH_PREFIX   pre-filled prefix when naming a brand new branch
#   TW_PR_TTL          seconds before the pull request cache goes stale
#   TW_NO_FETCH        set to skip the fetch in the create flow
#   TW_ENV_DOMAIN      hostname suffix for envs   (default localhost)
#   TW_ENV_PORT_BASE   first port envs draw from  (default 20000)
#   TW_ENV_PORT_SPAN   ports reserved per env     (default 40)
#   TW_AGENT_PATTERN   process names counted as agents, for the live tag
#
# Repo specific behaviour lives in hooks: env, setup, teardown, run. Looked up
# in $TMW_DIR/repos/<repo>/, then $TMW_DIR/hooks/, then the repo's own bin/.
# $TMW_DIR defaults to ~/.config/tmw. See the README for the contract.

set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
TAB=$'\t'

TW_ROOT="${TW_ROOT:-$HOME/work/.worktrees}"
TW_ROOTS="${TW_ROOTS:-$HOME/src:$HOME/work}"
TW_REPOS="${TW_REPOS:-$HOME/dotfiles}"
TW_PR_TTL="${TW_PR_TTL:-900}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-worktreeizer"

# Everything machine or repo specific lives here: a config file for settings,
# and hooks for the parts only a given repo can know. See the README.
TMW_DIR="${TMW_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tmw}"
[[ -f $TMW_DIR/config ]] && . "$TMW_DIR/config"

# ---------------------------------------------------------------- helpers

die() {
  printf 'tmux-worktreeizer: %s\n' "$*" >&2
  exit 1
}

pause() {
  [[ -t 0 ]] || return 0
  read -rsn1 -p "press any key to continue..." _ || true
  printf '\n'
}

slug() {
  printf '%s' "$1" |
    tr 'A-Z/ ' 'a-z--' |
    sed -e 's/[^a-z0-9._-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

# Turn typed-in text into something git will accept as a branch name.
sanitize_branch() {
  printf '%s' "$1" |
    tr -s ' \t' '--' |
    sed -e 's|^/*||' -e 's|/*$||' -e 's|//*|/|g'
}

# Ask for a value with an editable default already filled in.
prompt_default() {
  local prompt=$1 def=$2 out=""
  if [[ -t 0 ]]; then
    read -r -e -i "$def" -p "$prompt" out || return 1
  else
    read -r -p "$prompt[$def] " out || return 1
    out="${out:-$def}"
  fi
  printf '%s' "$out"
}

repo_of() {
  local common
  common="$(git -C "${1:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  (cd "$common/.." && pwd)
}

main_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null |
    awk '/^worktree /{print substr($0,10); exit}'
}

# Why a worktree is locked, empty when it is not. Agent tooling locks the
# worktrees it makes so git will not prune them while a session is running.
lock_reason() {
  git -C "$1" worktree list --porcelain 2>/dev/null |
    awk -v want="$2" '
      /^worktree /{ cur = substr($0, 10) }
      /^locked/ {
        if (cur != want) next
        reason = substr($0, 7)
        sub(/^ /, "", reason)
        print (reason == "" ? "(no reason given)" : reason)
        exit
      }'
}

default_branch() {
  local repo=$1 ref
  ref="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
  if [[ -n $ref ]]; then
    printf '%s' "$ref"
    return
  fi
  for ref in origin/master origin/main; do
    if git -C "$repo" rev-parse --verify --quiet "refs/remotes/$ref" >/dev/null; then
      printf '%s' "$ref"
      return
    fi
  done
  git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null
}

# Light or dark, so the highlighted row is readable either way. Prefers the
# symlink tmux-dark-notify keeps, since that is what tmux itself follows.
appearance() {
  local link
  link="$(readlink "${XDG_STATE_HOME:-$HOME/.local/state}/tmux/tmux-dark-notify-theme.conf" 2>/dev/null)"
  case $link in
  *light*)
    printf 'light'
    return
    ;;
  *dark*)
    printf 'dark'
    return
    ;;
  esac
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]]; then
    printf 'dark'
  else
    printf 'light'
  fi
}

sessions_at() {
  tmux list-sessions -F "#{session_path}${TAB}#{session_name}" 2>/dev/null |
    awk -F"$TAB" -v p="$1" '$1 == p {print $2}'
}

# Every tmux session rooted at a path, gone. Moves the client off one first if
# it is the session attached to this popup, so the popup itself survives.
kill_sessions_at() {
  local path=$1 current session killed=0
  current="$(tmux display-message -p '#{session_name}' 2>/dev/null)"
  while read -r session; do
    [[ -n $session ]] || continue
    if [[ $session == "$current" ]]; then
      tmux switch-client -l 2>/dev/null || tmux switch-client -n 2>/dev/null
    fi
    tmux kill-session -t "=$session" 2>/dev/null && {
      killed=$((killed + 1))
      printf '%s\n' "$session"
    }
  done < <(sessions_at "$path")
  ((killed > 0))
}

# ---------------------------------------------------------------- repos

repo_list() {
  local roots=() extra=() root dir
  IFS=: read -ra roots <<<"$TW_ROOTS"
  IFS=: read -ra extra <<<"$TW_REPOS"
  for root in "${roots[@]}"; do
    [[ -d $root ]] || continue
    for dir in "$root"/*/; do
      dir="${dir%/}"
      [[ -d "$dir/.git" ]] && printf '%s\n' "$dir"
    done
  done
  for dir in "${extra[@]}"; do
    [[ -n $dir && -d "$dir/.git" ]] && printf '%s\n' "$dir"
  done
}

has_extra_worktrees() {
  compgen -G "$1/.git/worktrees/*" >/dev/null 2>&1
}

# ---------------------------------------------------------------- pull requests

pr_cache_file() {
  printf '%s/pr%s.tsv' "$CACHE_DIR" "$(printf '%s' "$1" | tr '/ ' '__')"
}

refresh_prs() {
  local repo=$1 file tmp
  command -v gh >/dev/null 2>&1 || return 0
  file="$(pr_cache_file "$repo")"
  tmp="$file.$$"
  mkdir -p "$CACHE_DIR"
  if (cd "$repo" && gh pr list --state all --limit 200 \
    --json number,headRefName,state,isDraft,url \
    --jq '.[] | [.headRefName, (.number|tostring),
                 (if .state == "OPEN" and .isDraft then "draft"
                  else (.state|ascii_downcase) end), .url] | @tsv') >"$tmp" 2>/dev/null; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
  fi
}

pr_cache_stale() {
  local file age
  file="$(pr_cache_file "$1")"
  [[ -f $file ]] || return 0
  age=$(($(date +%s) - $(stat -f %m "$file")))
  ((age > TW_PR_TTL))
}

# Kick off cache refreshes for the repos that actually have worktrees.
refresh_prs_in_background() {
  local repo
  command -v gh >/dev/null 2>&1 || return 0
  while read -r repo; do
    has_extra_worktrees "$repo" || continue
    pr_cache_stale "$repo" || continue
    (refresh_prs "$repo" &) >/dev/null 2>&1
  done < <(repo_list)
}

# ---------------------------------------------------------------- listing

PORCELAIN_AWK='
function emit() { print p "\t" b "\t" f }
/^worktree /   { if (p != "") emit(); p = substr($0, 10); b = ""; f = "" }
/^branch /     { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
/^detached$/   { b = "(detached)" }
/^locked/      { f = f (f ? "," : "") "locked" }
/^prunable/    { f = f (f ? "," : "") "prunable" }
/^bare$/       { f = f (f ? "," : "") "bare" }
END            { if (p != "") emit() }
'

RENDER_AWK='
function tildify(p) {
  if (index(p, HOME) == 1) return "~" substr(p, length(HOME) + 1)
  return p
}
function pad(s, w) {
  if (length(s) > w) return substr(s, 1, w - 1) ">"
  while (length(s) < w) s = s " "
  return s
}
function spaces(k, s) { s = ""; while (k-- > 0) s = s " "; return s }
# Pad by the width of the plain text, so ANSI codes do not break alignment.
function padkeep(plain, w, colored) {
  if (length(plain) > w) return substr(plain, 1, w - 1) ">"
  return colored spaces(w - length(plain))
}
function paint(s, c) {
  if (!color || c == "" || s == "") return s
  return "\033[" c "m" s "\033[0m"
}
function base(p, a, k) { k = split(p, a, "/"); return a[k] }
# Some tools nest worktrees as <hash>/<repo-name>, so the last component
# alone tells you nothing. Fall back to the parent in that case.
function label(p, a, k) {
  k = split(p, a, "/")
  if (k > 1 && a[k] == base(repo)) return a[k - 1] "/" a[k]
  return a[k]
}
function isagent(p) {
  return (index(p, "/.claude/worktrees/") || index(p, "/.codex/worktrees/")) ? 1 : 0
}
function statustxt(b, t) {
  if (b == "" || b == "(detached)") return "detached"
  if (up[b] == "") return "no-remote"
  t = track[b]
  if (t == "") return "pushed"
  gsub(/[\[\]]/, "", t)
  if (t == "gone") return "gone"
  gsub(/ahead /, "+", t); gsub(/behind /, "-", t); gsub(/, /, "/", t)
  return t
}
function statuscolor(s) {
  if (s == "pushed")    return "32"
  if (s == "no-remote") return "33"
  if (s == "gone")      return "31"
  if (s == "detached")  return "35"
  return "36"
}
function prtxt(b) {
  if (b == "" || !(b in prnum)) return ""
  return "PR #" prnum[b] " " prstate[b]
}
function prcolor(b, s) {
  s = prstate[b]
  if (s == "open")   return "32"
  if (s == "draft")  return "33"
  if (s == "merged") return "35"
  if (s == "closed") return "31"
  return ""
}
function mark(p) {
  if (runstate[p] == "up") return ">"
  if (runstate[p] == "dead") return "!"
  return (p in sess) ? "*" : " "
}
function runtxt(p) {
  if (runstate[p] == "up") return ":" runport[p]
  if (runstate[p] == "booting") return "booting"
  if (runstate[p] == "dead") return "dead"
  return ""
}
function runcolor(p) {
  if (runstate[p] == "up") return "32"
  if (runstate[p] == "booting") return "33"
  if (runstate[p] == "dead") return "31"
  return ""
}
function prurlof(b) { return (b in prurl) ? prurl[b] : "" }

$1 == "B" { up[$2] = $3; track[$2] = $4 }
$1 == "P" { if (!($2 in prnum)) { prnum[$2] = $3; prstate[$2] = $4; prurl[$2] = $5 } }
$1 == "S" { sess[$2] = $3 }
$1 == "R" { runport[$2] = $3; runstate[$2] = $4; agentlive[$2] = $5 }
$1 == "W" { n++; wpath[n] = $2; wbranch[n] = $3; wflags[n] = $4 }

END {
  if (n == 0) exit
  rname = base(repo)
  hb = wbranch[1]
  hst = statustxt(hb)

  # One row per repo. Enter on it drills into that repo.
  if (view == "repos") {
    extra = n - 1
    print "repo", repo, wpath[1], hb, prurlof(hb), \
          paint(mark(wpath[1]), "36") " " \
          paint(pad(tildify(wpath[1]), 40), REPO_C) " " \
          paint(pad("[" hb "]", 24), "90") " " \
          paint(pad(hst, 10), statuscolor(hst)) " " \
          paint(pad(prtxt(hb), 17), prcolor(hb)) " " \
          paint(extra > 0 ? extra " worktree" (extra == 1 ? "" : "s") : "", "90")
    exit
  }

  # Inside an env, only the worktree matching that env name matters here.
  if (view == "env") {
    for (i = 2; i <= n; i++) {
      if (base(wpath[i]) != pick) continue
      b = wbranch[i]
      st = statustxt(b)
      print "wt", repo, wpath[i], b, prurlof(b), \
            paint(mark(wpath[i]), "36") " " \
            padkeep(rname "/" pick, 40, paint(rname, REPO_C) "/" pick) " " \
            paint(pad((b == "" || b == pick) ? "" : "[" b "]", 24), "90") " " \
            paint(pad(st, 10), statuscolor(st)) " " \
            paint(pad(runtxt(wpath[i]), 8), runcolor(wpath[i])) " " \
            paint(pad(prtxt(b), 14), prcolor(b)) " " \
            paint(wflags[i], "90")
    }
    exit
  }

  if (view == "flat") {
    # Just the worktrees here -- the main checkout is not one, and repos.list
    # is where it belongs.
  } else {
    print "repo", repo, wpath[1], hb, prurlof(hb), \
          paint(mark(wpath[1]), "36") " " \
          paint(pad(tildify(wpath[1]), 40), REPO_C) " " \
          paint(pad("[" hb "]", 24), "90") " " \
          paint(pad(hst, 10), statuscolor(hst)) " " \
          paint(prtxt(hb), prcolor(hb))
    print "new", repo, "", "", "", \
          "  " paint(pad("|- create new worktree", 40), "32") " " \
          paint("(" rname ")", "90")
  }

  for (agent = 0; agent < 2; agent++) {
    for (i = 2; i <= n; i++) {
      if (isagent(wpath[i]) != agent) continue
      b = wbranch[i]
      st = statustxt(b)
      name = label(wpath[i])
      shown = (b == "" || b == name) ? "" : "[" b "]"
      tag = wflags[i]
      if (agent) tag = tag (tag ? "," : "") "agent"
      # An agent process is sitting in this worktree right now.
      if (agentlive[wpath[i]] == 1) tag = tag (tag ? "," : "") "live"
      # The repo name rides along on every row so that typing it filters the
      # whole group -- fzf can only search what it displays.
      pre = (view == "flat") ? "" : "|- "
      print "wt", repo, wpath[i], b, prurlof(b), \
            paint(mark(wpath[i]), "36") " " \
            padkeep(pre rname "/" name, 40, \
                    pre paint(rname "/", "90") name) " " \
            paint(pad(shown, 24), "90") " " \
            paint(pad(st, 10), statuscolor(st)) " " \
            paint(pad(runtxt(wpath[i]), 8), runcolor(wpath[i])) " " \
            paint(pad(prtxt(b), 14), prcolor(b)) " " \
            paint(tag, "90")
    }
  }
  if (view == "group") print "sep", repo, "", "", "", " "
}
'

# ---------------------------------------------------------------- envs
#
# An env is just a name. Every worktree called that name, in any repo, is part
# of it; repos without one fall back to their main checkout. So making a
# change in one repo that needs a change in another means using the same
# worktree name in both, and everything else keeps pointing at master.

TW_ENV_DOMAIN="${TW_ENV_DOMAIN:-localhost}"
TW_ENV_PORT_BASE="${TW_ENV_PORT_BASE:-20000}"
TW_ENV_PORT_SPAN="${TW_ENV_PORT_SPAN:-40}"
TW_ENV_SLOTS="${TW_ENV_SLOTS:-500}"

# Every env name, which is every directory name under the worktree root.
#
# Ends with an explicit return: with pipefail on (set at the top of this
# script), "for ... done | sort" takes its exit status from whichever
# directory the loop happened to check last, which has nothing to do with
# whether the function actually found anything. Silent when only the output
# is read, as every caller here does, but a caller that ever checks the exit
# status directly (service_port did, and that is how this got noticed) would
# get a essentially random true/false.
env_names() {
  local repo dir
  [[ -d $TW_ROOT ]] || return 0
  for repo in "$TW_ROOT"/*/; do
    [[ -d $repo ]] || continue
    for dir in "$repo"*/; do
      [[ -d $dir ]] || continue
      basename "${dir%/}"
    done
  done | sort -u
  return 0
}

# Repo names taking part in an env, in a stable order. See env_names above for
# why this ends with an explicit return.
env_repos() {
  local name=$1 repo
  for repo in "$TW_ROOT"/*/; do
    [[ -d "$repo$name" ]] && basename "${repo%/}"
  done | sort
  return 0
}

# Ports are derived from the name, never allocated, so that nothing has to
# keep a ledger and the numbers survive restarts.
env_port_base() {
  local sum
  sum="$(printf '%s' "$1" | cksum | awk '{print $1}')"
  printf '%d' "$((TW_ENV_PORT_BASE + (sum % TW_ENV_SLOTS) * TW_ENV_PORT_SPAN))"
}

# An env is a hostname *prefix*, not a hostname. Services keep their own names
# (app, ui, ask, socks ...) because only nginx knows which name each one
# answers on, that app and api share an upstream, and that some services are
# paths rather than hostnames. This pattern is for display only; nginx composes
# the real names by putting the prefix in front of its own.
# Set outside a ${...:-default} because a literal } would end the expansion.
: "${TW_ENV_HOST_PATTERN=}"
[[ -n $TW_ENV_HOST_PATTERN ]] || TW_ENV_HOST_PATTERN='{env}.{domain}'

env_host() {
  local out="$TW_ENV_HOST_PATTERN"
  out="${out//\{env\}/$1}"
  printf '%s' "${out//\{domain\}/$TW_ENV_DOMAIN}"
}

env_worktree() { printf '%s/%s/%s' "$TW_ROOT" "$1" "$2"; }

# Turn a repo name back into its path, since repos can live under any root.
repo_path_for() {
  local want=$1 repo
  while read -r repo; do
    if [[ "$(basename "$repo")" == "$want" ]]; then
      printf '%s' "$repo"
      return 0
    fi
  done < <(repo_list)
  return 1
}

# How many of an env's worktrees have a tmux session open.
env_live_count() {
  local name=$1 repo n=0
  while read -r repo; do
    [[ -n $repo ]] || continue
    [[ -n "$(sessions_at "$(env_worktree "$repo" "$name")")" ]] && n=$((n + 1))
  done < <(env_repos "$name")
  printf '%d' "$n"
}

# What a proxy reads to render a server block per env. Absent file means
# nothing changes for it.
write_manifest() {
  local out="$CACHE_DIR/envs.json" name repo base port first_env=1 first_svc path branch
  mkdir -p "$CACHE_DIR"
  {
    printf '{\n'
    printf '  "domain": "%s",\n' "$TW_ENV_DOMAIN"
    printf '  "envs": {\n'
    while read -r name; do
      [[ -n $name ]] || continue
      ((first_env)) || printf ',\n'
      first_env=0
      base="$(env_port_base "$name")"
      printf '    "%s": {\n' "$name"
      printf '      "prefix": "%s",\n' "$name"
      printf '      "primary_host": "%s",\n' "$(env_host "$name")"
      printf '      "port_base": %s,\n' "$base"
      printf '      "services": {\n'
      first_svc=1
      while read -r repo; do
        [[ -n $repo ]] || continue
        path="$(env_worktree "$repo" "$name")"
        branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null)"
        # Asked of service_port rather than computed here: this used to keep
        # its own "base + position" math, which fell out of step the moment
        # service_port was fixed to hash (env, repo) instead -- the manifest
        # was pointing nginx at ports nothing was actually listening on.
        port="$(service_port "$name" "$repo")" || continue
        ((first_svc)) || printf ',\n'
        first_svc=0
        printf '        "%s": { "path": "%s", "branch": "%s", "port": %s }' \
          "$repo" "$path" "$branch" "$port"
      done < <(env_repos "$name")
      printf '\n      }\n'
      printf '    }'
    done < <(env_names)
    printf '\n  }\n}\n'
  } >"$out"
  printf '%s\n' "$out"
}

# Any create or remove can change which repos are in an env, so the manifest
# is kept current automatically rather than waiting for someone to remember
# --manifest. $TMW_DIR/hooks/manifest is the one hook that is not per repo --
# there is no repo to resolve it against, since this fires regardless of which
# repo's worktree just changed -- so it is a single optional script, run if it
# exists, with nothing to configure. Best effort: a proxy that is not running,
# or a hook that fails, never blocks the create or remove itself.
refresh_manifest_hook() {
  write_manifest >/dev/null
  local hook="$TMW_DIR/hooks/manifest"
  [[ -x $hook ]] && "$hook"
  return 0
}

list_envs() {
  local name repos count base mark label run runs up dead states
  if [[ -z "$(env_names)" ]]; then
    printf 'sep\t\t\t\t\t%sno envs yet. Create worktrees with the same name in two repos.%s\n' \
      "$C_DIM" "$C_OFF"
    return 0
  fi
  states="$(run_state_map 2>/dev/null)"
  while read -r name; do
    [[ -n $name ]] || continue
    repos="$(env_repos "$name" | paste -sd, -)"
    count="$(env_repos "$name" | grep -c . | tr -d ' ')"
    base="$(env_port_base "$name")"

    # How many of this env's services are actually serving.
    up="$(printf '%s\n' "$states" | awk -F"$TAB" -v r="$TW_ROOT/" -v n="/$name" \
      '$1 ~ "^" r && $1 ~ n "$" && $3 == "up" { c++ } END { print c + 0 }')"
    dead="$(printf '%s\n' "$states" | awk -F"$TAB" -v r="$TW_ROOT/" -v n="/$name" \
      '$1 ~ "^" r && $1 ~ n "$" && $3 == "dead" { c++ } END { print c + 0 }')"

    if ((up > 0)); then
      mark='>'
      run="$(pv_paint 32 "$up/$count up")"
    elif ((dead > 0)); then
      mark='!'
      run="$(pv_paint 31 'crashed')"
    else
      mark=' '
      run="$(pv_paint 90 'stopped')"
    fi

    label="$count repo"
    ((count == 1)) || label="$label"s
    printf 'env\t%s\t%s\t%s\thttps://%s\t' "$name" "$base" "$(env_host "$name")" "$(env_host "$name")"
    printf '%s %s %s %s %s %s\n' \
      "$(pv_paint 36 "$mark")" \
      "$(printf '\033[1;34m%-28s\033[0m' "$name")" \
      "$(printf '\033[90m%-22s\033[0m' "$(env_host "$name")")" \
      "$(printf '\033[90m:%-6s\033[0m' "$base")" \
      "$(printf '%-9s' "$run")" \
      "$(pv_paint 90 "$label: $repos")"
  done < <(env_names)
}

# One row per worktree in an env, so enter on an env shows what is in it.
list_env_members() {
  local name=$1 repo tmpdir sess_file run_file i=0
  tmpdir="$(mktemp -d)"
  sess_file="$tmpdir/sessions"
  tmux list-sessions -F "S${TAB}#{session_path}${TAB}#{session_name}" 2>/dev/null >"$sess_file" || :
  touch "$sess_file"
  run_file="$tmpdir/runstate"
  run_state_map >"$run_file" 2>/dev/null || :
  touch "$run_file"
  local path
  while read -r repo; do
    [[ -n $repo ]] || continue
    path="$(repo_path_for "$repo")" || continue
    i=$((i + 1))
    render_repo "$path" "$sess_file" env "$name" "$run_file" \
      >"$tmpdir/out.$(printf '%04d' "$i")" &
  done < <(env_repos "$name")
  wait
  cat "$tmpdir"/out.* 2>/dev/null
  rm -rf "$tmpdir"
}

render_repo() {
  local repo=$1 sess_file=$2 view=${3:-group} pick=${4:-} run_file=${5:-} pr_file
  pr_file="$(pr_cache_file "$repo")"
  {
    git -C "$repo" for-each-ref \
      --format="B${TAB}%(refname:short)${TAB}%(upstream:short)${TAB}%(upstream:track)" \
      refs/heads 2>/dev/null
    [[ -f $pr_file ]] && sed "s|^|P${TAB}|" "$pr_file"
    cat "$sess_file"
    [[ -n $run_file && -f $run_file ]] && sed "s|^|R${TAB}|" "$run_file"
    git -C "$repo" worktree list --porcelain 2>/dev/null |
      awk "$PORCELAIN_AWK" | sed "s|^|W${TAB}|"
  } | awk -F"$TAB" -v OFS="$TAB" -v repo="$repo" -v HOME="$HOME" -v color=1 \
    -v view="$view" -v pick="$pick" -v REPO_C="1;34" "$RENDER_AWK"
}

list_view() {
  local view=$1 only=${2:-} tmpdir sess_file run_file here repo key i=0
  tmpdir="$(mktemp -d)"
  sess_file="$tmpdir/sessions"
  tmux list-sessions -F "S${TAB}#{session_path}${TAB}#{session_name}" 2>/dev/null >"$sess_file" || :
  touch "$sess_file"
  run_file="$tmpdir/runstate"
  run_state_map >"$run_file" 2>/dev/null || :
  touch "$run_file"

  if [[ -n $only ]]; then
    render_repo "$only" "$sess_file" "$view" "" "$run_file"
    rm -rf "$tmpdir"
    return
  fi

  here="$(repo_of "$PWD" 2>/dev/null)" || here=""

  # The repo you are standing in first, then repos that already have
  # worktrees, then the rest.
  while read -r repo; do
    if [[ -n $here && $repo == "$here" ]]; then
      key=0
    elif has_extra_worktrees "$repo"; then
      key=1
    else
      key=2
    fi
    printf '%s\t%s\t%s\n' "$key" "$(basename "$repo")" "$repo"
  done < <(repo_list) | sort -t"$TAB" -k1,1 -k2,2 >"$tmpdir/repos"

  while IFS="$TAB" read -r _ _ repo; do
    i=$((i + 1))
    render_repo "$repo" "$sess_file" "$view" "" "$run_file" >"$tmpdir/out.$(printf '%04d' "$i")" &
  done <"$tmpdir/repos"
  wait

  cat "$tmpdir"/out.* 2>/dev/null
  rm -rf "$tmpdir"
}

# ---------------------------------------------------------------- views

# Which view the picker is showing, kept in one fixed file so that fzf's
# reload and transform bindings all see the same thing. A fixed path rather
# than a temp dir, because ctrl-t replaces this process and would never get
# the chance to clean a temp one up.
state_file() { printf '%s/view' "${TW_STATE:-$CACHE_DIR}"; }

view_read() {
  local file
  file="$(state_file)"
  if [[ -f $file ]]; then
    cat "$file"
  else
    printf 'repos\t\n'
  fi
}

view_write() { printf '%s\t%s\n' "$1" "$2" >"$(state_file)"; }

# The actions fzf should run to show the current view.
view_actions() {
  local mode=$1 drill=$2 prompt
  case $drill in
  env:*) prompt="${drill#env:}> " ;;
  '')
    case $mode in
    flat) prompt='worktrees> ' ;;
    envs) prompt='envs> ' ;;
    *) prompt='repos> ' ;;
    esac
    ;;
  *) prompt="$(basename "$drill")> " ;;
  esac
  printf 'reload(%s --view-list)+change-prompt(%s)+first' "$SELF" "$prompt"
}

do_view_list() {
  local mode drill
  IFS="$TAB" read -r mode drill <<<"$(view_read)"
  case $drill in
  env:*) list_env_members "${drill#env:}" ;;
  '')
    case $mode in
    flat) list_view flat ;;
    envs) list_envs ;;
    *) list_view repos ;;
    esac
    ;;
  *) list_view tree "$drill" ;;
  esac
}

# The backtick key: leave whatever you drilled into, or move to the next mode.
do_view_toggle() {
  local mode drill
  IFS="$TAB" read -r mode drill <<<"$(view_read)"
  if [[ -n $drill ]]; then
    drill=""
  else
    case $mode in
    repos) mode=flat ;;
    flat) mode=envs ;;
    *) mode=repos ;;
    esac
  fi
  view_write "$mode" "$drill"
  view_actions "$mode" "$drill"
}

# Backspace steps out of a folder, but only once the query is empty --
# otherwise it has to keep deleting characters like it normally would.
do_view_back() {
  local query=${1:-} mode drill
  if [[ -n $query ]]; then
    printf 'backward-delete-char'
    return 0
  fi
  IFS="$TAB" read -r mode drill <<<"$(view_read)"
  if [[ -n $drill ]]; then
    view_write "$mode" ""
    view_actions "$mode" ""
  else
    printf 'ignore'
  fi
}

# Enter opens a repo or an env when browsing them, and otherwise just accepts.
do_view_enter() {
  local kind=${1:-} repo=${2:-} mode drill
  IFS="$TAB" read -r mode drill <<<"$(view_read)"
  if [[ -z $drill && $mode == envs && $kind == env && -n $repo ]]; then
    view_write "$mode" "env:$repo"
    view_actions "$mode" "env:$repo"
  elif [[ -z $drill && $mode == repos && $kind == repo && -n $repo ]]; then
    view_write "$mode" "$repo"
    view_actions "$mode" "$repo"
  else
    printf 'accept'
  fi
}

# Every repo with its worktrees under it, the old grouped listing.
list_all() { list_view group; }

# ---------------------------------------------------------------- preview

C_OFF=$'\033[0m'
C_DIM=$'\033[90m'
C_BOLD=$'\033[1m'
C_TITLE=$'\033[1;34m'

pv_field() { printf '%s%-9s%s %s\n' "$C_DIM" "$1" "$C_OFF" "$2"; }
pv_section() { printf '\n%s%s%s\n' "$C_BOLD" "$1" "$C_OFF"; }
pv_paint() { printf '\033[%sm%s%s' "$1" "$2" "$C_OFF"; }

pv_status_color() {
  case $1 in
  pushed) printf '32' ;;
  no-remote) printf '33' ;;
  gone) printf '31' ;;
  detached) printf '35' ;;
  *) printf '36' ;;
  esac
}

pv_pr_color() {
  case $1 in
  open) printf '32' ;;
  draft) printf '33' ;;
  merged) printf '35' ;;
  closed) printf '31' ;;
  *) printf '90' ;;
  esac
}

do_preview() {
  local kind=${1:-} repo=${2:-} path=${3:-} branch=${4:-}
  local rname pr_file upstream track sessions locked
  local changed untracked stat state num url

  case $kind in
  sep | '') return 0 ;;
  env)
    local name=$2 base=$3 host=$4 member repo port i=0 wt
    printf '%s%s%s\n' "$C_TITLE" "$name" "$C_OFF"
    printf '%severy service keeps its own name, with %s in front:%s\n' "$C_DIM" "$name" "$C_OFF"
    printf '%s  https://%s  and the same prefix on ui, ask, socks ...%s\n\n' "$C_DIM" "$host" "$C_OFF"
    pv_field 'ports' "$base - $((base + TW_ENV_PORT_SPAN - 1))"
    pv_section 'in this env'
    while read -r member; do
      [[ -n $member ]] || continue
      wt="$(env_worktree "$member" "$name")"
      port=$((base + i))
      i=$((i + 1))
      printf '  %-22s %s%s%s  %s\n' "$member" "$C_DIM" "port $port" "$C_OFF" \
        "$([[ -n "$(sessions_at "$wt")" ]] && pv_paint 32 'session open' || pv_paint 90 'no session')"
    done < <(env_repos "$name")
    pv_section 'falling back to the main checkout'
    while read -r repo; do
      repo="$(basename "$repo")"
      env_repos "$name" | grep -qx "$repo" || printf '  %s%s%s\n' "$C_DIM" "$repo" "$C_OFF"
    done < <(repo_list) | head -12
    return 0
    ;;
  new)
    rname="$(basename "$repo")"
    printf '%screate a new worktree in %s%s\n\n' "$C_TITLE" "$rname" "$C_OFF"
    pv_field 'base' 'an existing branch, or a new one off the default branch'
    pv_field 'path' "${TW_ROOT/#$HOME/~}/$rname/$C_DIM<name>$C_OFF"
    pv_field 'name' 'you get a prompt with a suggestion already filled in'
    pv_section 'worktrees that exist now'
    git -C "$repo" worktree list 2>/dev/null | sed "s|^|  |;s|$HOME|~|"
    return 0
    ;;
  esac

  rname="$(basename "$repo")"

  # Title: which worktree this is, then where it lives.
  if [[ $path == "$repo" ]]; then
    printf '%s%s%s %s(the repo itself)%s\n' "$C_TITLE" "$rname" "$C_OFF" "$C_DIM" "$C_OFF"
  else
    printf '%s%s/%s%s\n' "$C_TITLE" "$rname" "$(basename "$path")" "$C_OFF"
  fi
  printf '%s%s%s\n\n' "$C_DIM" "${path/#$HOME/~}" "$C_OFF"

  if [[ -n $branch ]]; then
    pv_field 'branch' "$branch"
  else
    pv_field 'branch' "$(pv_paint 35 'detached head')"
  fi

  # Upstream, and how far from it.
  if [[ -n $branch ]]; then
    upstream="$(git -C "$repo" for-each-ref --format='%(upstream:short)' \
      "refs/heads/$branch" 2>/dev/null)"
    track="$(git -C "$repo" for-each-ref --format='%(upstream:track)' \
      "refs/heads/$branch" 2>/dev/null)"
    if [[ -z $upstream ]]; then
      pv_field 'upstream' "$(pv_paint 33 'none, nothing pushed yet')"
    elif [[ $track == '[gone]' ]]; then
      pv_field 'upstream' "$upstream $(pv_paint 31 'gone from the remote')"
    elif [[ -z $track ]]; then
      pv_field 'upstream' "$upstream $(pv_paint 32 'in sync')"
    else
      pv_field 'upstream' "$upstream $(pv_paint 36 "$track")"
    fi
  fi

  # Working tree state.
  if [[ -d $path ]]; then
    changed="$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')"
    untracked="$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')"
    stat="$(git -C "$path" diff --shortstat 2>/dev/null | sed 's/^ *//')"
    if ((changed == 0 && untracked == 0)); then
      pv_field 'files' "$(pv_paint 32 'clean')"
    else
      pv_field 'files' "$(pv_paint 33 "$changed changed, $untracked untracked")${stat:+  $C_DIM$stat$C_OFF}"
    fi
  else
    pv_field 'files' "$(pv_paint 31 'the directory is missing')"
  fi

  sessions="$(sessions_at "$path" | paste -sd, -)"
  if [[ -n $sessions ]]; then
    pv_field 'session' "$(pv_paint 32 "$sessions")"
  else
    pv_field 'session' "$(pv_paint 90 'none open')"
  fi

  # Pull request, from the cache.
  pr_file="$(pr_cache_file "$repo")"
  if [[ -z $branch ]]; then
    pv_field 'pr' "$(pv_paint 90 'no branch, so no pull request')"
  elif [[ ! -f $pr_file ]]; then
    pv_field 'pr' "$(pv_paint 90 'not fetched yet, ctrl-r to look')"
  else
    IFS="$TAB" read -r num state url < <(awk -F"$TAB" -v b="$branch" \
      '$1 == b {print $2 "\t" $3 "\t" $4; exit}' "$pr_file")
    if [[ -n ${num:-} ]]; then
      pv_field 'pr' "$(pv_paint "$(pv_pr_color "$state")" "#$num $state")  $C_DIM$url$C_OFF"
    else
      pv_field 'pr' "$(pv_paint 90 'none found for this branch')"
    fi
  fi

  locked="$(lock_reason "$repo" "$path")"
  [[ -n $locked ]] && pv_field 'locked' "$(pv_paint 33 "$locked")"

  [[ -d $path ]] || return 0

  # Commits that only exist here are the ones worth seeing first.
  if [[ -n $branch ]] && git -C "$path" rev-parse --verify --quiet '@{u}' >/dev/null 2>&1; then
    if [[ -n "$(git -C "$path" log --oneline '@{u}..HEAD' 2>/dev/null)" ]]; then
      pv_section 'not pushed yet'
      git -C "$path" log --color=always --oneline --decorate '@{u}..HEAD' 2>/dev/null |
        head -10 | sed 's|^|  |'
    fi
  fi

  if ((changed > 0 || untracked > 0)); then
    pv_section 'changes'
    git -C "$path" -c color.status=always status --short 2>/dev/null | head -20 | sed 's|^|  |'
  fi

  pv_section 'recent commits'
  git -C "$path" log --color=always --oneline --decorate -8 2>/dev/null | sed 's|^|  |'
}

# ---------------------------------------------------------------- jumping

# Print an fzf action that moves the cursor to the next or previous repo
# header. Arguments are the kind of every row fzf is currently showing, in
# order, and FZF_POS says which one the cursor is on.
do_jump() {
  local direction=$1 pos=${FZF_POS:-1} count i
  shift
  count=$#
  ((count > 0)) || return 0

  if [[ $direction == next ]]; then
    for ((i = pos + 1; i <= count; i++)); do
      [[ ${!i} == repo ]] && {
        printf 'pos(%d)' "$i"
        return 0
      }
    done
    for ((i = 1; i <= pos; i++)); do
      [[ ${!i} == repo ]] && {
        printf 'pos(%d)' "$i"
        return 0
      }
    done
  else
    for ((i = pos - 1; i >= 1; i--)); do
      [[ ${!i} == repo ]] && {
        printf 'pos(%d)' "$i"
        return 0
      }
    done
    for ((i = count; i > pos; i--)); do
      [[ ${!i} == repo ]] && {
        printf 'pos(%d)' "$i"
        return 0
      }
    done
  fi
}

# ---------------------------------------------------------------- sessions

# ---------------------------------------------------------------- running

# Repos declare how to set themselves up and how to run. Absent means skip.
# ---------------------------------------------------------------- hooks
#
# Everything a repo needs that this tool cannot know goes in a hook, and there
# are two places for one:
#
#   in the repo      <repo>/bin/<hook>.sh, or bin/<hook>
#   on this machine  $TMW_DIR/repos/<repo>/<hook>, or $TMW_DIR/hooks/<hook>
#
# The repo's own hook is the important one: it is committed, so a teammate who
# has never heard of this tool still gets working setup by running it directly.
# The machine one is for anything personal, or for a repo you cannot commit to.
#
# setup, teardown and env run BOTH, repo first, so the personal hook adds to the
# committed one instead of replacing it. teardown runs them in reverse. run
# takes only one, since starting two servers makes no sense; there the personal
# hook wins.
#
# One more, shaped differently because it is not about any one repo: envs.json
# (the manifest a proxy reads) is rewritten after every create or remove, and
# $TMW_DIR/hooks/manifest runs right after if it exists -- for example, to
# reload a proxy that just picked up a new env. No repo to resolve it against,
# so it is a single optional script, not two.
#
# Hooks: env, setup, teardown, run, manifest. All optional.
repo_hook() {
  local repo=$1 hook=$2 f
  for f in "$repo/bin/$hook.sh" "$repo/bin/$hook"; do
    [[ -x $f ]] && {
      printf '%s' "$f"
      return 0
    }
  done
  return 1
}

personal_hook() {
  local repo=$1 hook=$2 name f main
  # Resolve to the repo the path belongs to: given a worktree, basename would
  # be the worktree's own name rather than the repo's.
  if main="$(repo_of "$repo" 2>/dev/null)"; then
    name="$(basename "$main")"
  else
    name="$(basename "${repo:-}")"
  fi
  [[ -n $name ]] || return 1
  for f in "$TMW_DIR/repos/$name/$hook" "$TMW_DIR/hooks/$hook"; do
    [[ -x $f ]] && {
      printf '%s' "$f"
      return 0
    }
  done
  return 1
}

# Both of them, repo first. One line each, empty when there are none.
hooks_for() {
  local repo=$1 hook=$2 f found=1
  f="$(repo_hook "$repo" "$hook")" && {
    printf '%s\n' "$f"
    found=0
  }
  f="$(personal_hook "$repo" "$hook")" && {
    printf '%s\n' "$f"
    found=0
  }
  return $found
}

# Just one, for hooks where running two would be wrong.
hook_for() {
  personal_hook "$1" "$2" || repo_hook "$1" "$2"
}

# debug.sh first: where a repo has both, that tends to be the development
# server and run.sh something else.
# A run hook if there is one, else the conventional scripts. debug.sh first,
# because where both exist that tends to be the development server.
run_script() {
  local repo=$1 f
  hook_for "$repo" run && return 0
  for f in bin/debug.sh bin/run.sh bin/dev.sh; do
    [[ -x "$repo/$f" ]] && {
      printf '%s' "$repo/$f"
      return 0
    }
  done
  return 1
}

# A repo that needs more than one process declares them in a Procfile, and
# runs them all in one window. An app is rarely just its web process: workers
# and schedulers belong there too, since with per-env queues the shared workers
# are looking elsewhere and would never see this env.s jobs.
procfile_for() {
  local path=$1 f
  for f in Procfile.dev Procfile; do
    [[ -f "$path/$f" ]] && {
      printf '%s' "$f"
      return 0
    }
  done
  return 1
}

# name<TAB>command per entry. Commented lines do not match, so they stay off.
procfile_entries() {
  awk '
    /^[a-zA-Z0-9_-]+:[[:space:]]/ {
      i = index($0, ":")
      name = substr($0, 1, i - 1)
      cmd = substr($0, i + 1)
      sub(/^[[:space:]]+/, "", cmd)
      sub(/[[:space:]]+$/, "", cmd)
      if (cmd != "") print name "\t" cmd
    }' "$1"
}

upper_snake() { printf '%s' "$1" | tr 'a-z.-' 'A-Z__'; }

# Which env a worktree belongs to, empty when it is not under the worktree root.
env_of_path() {
  local path=$1
  [[ $path == "$TW_ROOT"/* ]] || return 1
  basename "$path"
}

# A small stable number per env, used for the redis db block the way CI uses
# its bucket label. 0 is reserved for the main checkouts.
env_index() {
  local sum
  sum="$(printf '%s' "$1" | cksum | awk '{print $1}')"
  printf '%d' "$((sum % 15 + 1))"
}

# The port a given repo gets inside an env. Four apart, because a service can
# need more than one: a rails app may want three (web, debugger, control app)
# and a front end two. A span of 40 still fits ten services.
service_port() {
  local name=$1 repo=$2 base slots sum slot
  # Only a repo actually in the env gets a port; that also guards the hash
  # below from handing out a port to a repo this env has never heard of.
  env_repos "$name" | grep -qxF "$repo" || return 1
  base="$(env_port_base "$name")"
  slots=$((TW_ENV_PORT_SPAN / 4))
  # Hashed from (env, repo) rather than this repo's position in the env's
  # current member list: a repo's port must depend only on its own name, or
  # every other repo in the env shifts port the moment one more joins or
  # leaves -- which used to strand an already-running process on a port that
  # no longer matched what a fresh lookup would compute for it.
  sum="$(printf '%s\t%s' "$name" "$repo" | cksum | awk '{print $1}')"
  slot=$((sum % slots))
  printf '%d' "$((base + slot * 4))"
}

port_listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN -t >/dev/null 2>&1; }

# Worktrees an agent is sitting in, by asking which directories the agent
# processes have as their working directory. No integration with the agents
# themselves, so it says "something is working here", not what it is doing.
# One pgrep and one lsof, about 40ms for a couple of dozen processes.
agent_cwds() {
  local pids
  pids="$(pgrep -f "${TW_AGENT_PATTERN:-claude|codex|opencode|aider|gemini}" 2>/dev/null |
    paste -sd, -)"
  [[ -n $pids ]] || return 0
  lsof -a -p "$pids" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | sort -u
}

# Every listening TCP port on the machine, in one call. Asking per row would
# mean an lsof for each one, which is far too slow for a list.
listening_ports() {
  lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null |
    awk 'NR > 1 { n = split($9, a, ":"); print a[n] }' | sort -u
}

# What is running for each worktree in an env: path, its port, and one of
# up / booting / dead / empty. Built from two batched calls, so adding rows
# costs nothing.
run_state_map() {
  local ports panes agents name repo path port session state repo_path
  ports="$(listening_ports)"
  agents="$(agent_cwds)"
  panes="$(tmux list-panes -a -F "#{session_name}${TAB}#{window_name}${TAB}#{pane_current_command}${TAB}#{pane_dead}" 2>/dev/null)"
  while read -r name; do
    [[ -n $name ]] || continue
    while read -r repo; do
      [[ -n $repo ]] || continue
      path="$(env_worktree "$repo" "$name")"
      port="$(service_port "$name" "$repo")" || port=""
      repo_path="$(repo_path_for "$repo")" || repo_path="$repo"
      session="$(sessions_at "$path" | head -1)"
      [[ -n $session ]] || session="$(session_name_for "$repo_path" "$path")"
      state=""
      if [[ -n $port ]] && printf '%s\n' "$ports" | grep -qx "$port"; then
        state=up
      elif printf '%s\n' "$panes" |
        awk -F"$TAB" -v s="$session" '$1 == s && $2 == "server" && $4 == 1 { found = 1 } END { exit !found }'; then
        state=dead
      elif printf '%s\n' "$panes" |
        awk -F"$TAB" -v s="$session" '$1 == s && $2 == "server" && $3 !~ /^(fish|bash|zsh|sh|dash)$/ { found = 1 } END { exit !found }'; then
        state=booting
      fi
      printf '%s\t%s\t%s\t%s\n' "$path" "$port" "$state" \
        "$(printf '%s\n' "$agents" | grep -qxF "$path" && printf 1 || printf '')"
    done < <(env_repos "$name")
  done < <(env_names)

  # Agent worktrees are not under the worktree root, so they never appear above.
  # Emit them with no port or run state, just the flag.
  while read -r path; do
    [[ -n $path ]] || continue
    [[ $path == "$TW_ROOT"/* ]] && continue
    printf '%s\t\t\t1\n' "$path"
  done < <(printf '%s\n' "$agents")
}

# Everything a service in this env needs to find its peers. A peer that has no
# worktree in the env is simply absent here, so the reader falls back to the
# shared main checkout on its default port.
# The facts about an env, in this tool's own names. Nothing here knows what any
# application calls things.
env_facts() {
  local name=$1 repo=${2:-} member port key
  printf 'TW_ENV=%s\n' "$name"
  printf 'TW_ENV_INDEX=%s\n' "$(env_index "$name")"
  printf 'TW_ENV_HOST=%s\n' "$(env_host "$name")"
  printf 'TW_ENV_DOMAIN=%s\n' "$TW_ENV_DOMAIN"
  # Comma separated: a space here would break eval and every .env parser.
  printf 'TW_ENV_REPOS=%s\n' "$(env_repos "$name" | paste -sd, -)"
  printf 'TW_PORT_BASE=%s\n' "$(env_port_base "$name")"
  printf 'TW_PORT_SPAN=%s\n' "$TW_ENV_PORT_SPAN"
  while read -r member; do
    [[ -n $member ]] || continue
    port="$(service_port "$name" "$member")" || continue
    key="$(upper_snake "$member")"
    printf 'TW_%s_PORT=%s\n' "$key" "$port"
    printf 'TW_%s_HOST=%s\n' "$key" "127.0.0.1:$port"
  done < <(env_repos "$name")
  [[ -n $repo ]] || return 0
  printf 'TW_REPO=%s\n' "$repo"
  printf 'TW_WORKTREE=%s\n' "$(env_worktree "$repo" "$name")"
  # The main checkout, so a setup hook can copy or link the files git ignores
  # (.env, seed data, caches) out of it.
  printf 'TW_MAIN=%s\n' "$(repo_path_for "$repo" 2>/dev/null)"
  if port="$(service_port "$name" "$repo")"; then
    printf 'TW_PORT=%s\n' "$port"
    # PORT too, since that is what most things read to choose a port.
    printf 'PORT=%s\n' "$port"
  fi
}

# Those facts, plus whatever the repo's env hook makes of them. The hook is the
# only place that knows an application's own variable names, database offsets or
# endpoints; it receives the facts in its environment and prints more
# KEY=VALUE lines. See the README for the hook contract.
env_exports() {
  local name=$1 repo=${2:-} facts hook repo_path
  facts="$(env_facts "$name" "$repo")"
  printf '%s\n' "$facts"
  repo_path="$(repo_path_for "$repo" 2>/dev/null)" || repo_path="$repo"
  # Both hooks, repo first: a later line for the same name wins, so the machine
  # hook can adjust what the committed one published.
  while read -r hook; do
    [[ -n $hook ]] || continue
    (
      set -a
      eval "$facts"
      set +a
      "$hook"
    )
  done < <(hooks_for "$repo_path" env)
}

# Put the same values on the tmux session, so every window inherits them, and
# in a file for anything started outside tmux.
apply_env() {
  local session=$1 name=$2 repo=$3 path=$4 line key value common
  while IFS='=' read -r key value; do
    [[ -n $key ]] || continue
    tmux set-environment -t "=$session" "$key" "$value" 2>/dev/null
  done < <(env_exports "$name" "$repo")

  env_exports "$name" "$repo" >"$path/.env.worktree" 2>/dev/null || return 0

  # Keep that file out of git status without touching a tracked .gitignore.
  common="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  grep -qxF '.env.worktree' "$common/info/exclude" 2>/dev/null ||
    printf '.env.worktree\n' >>"$common/info/exclude" 2>/dev/null || true
}

# Other envs that look alive. Shared redis and mysql mean two running envs
# quietly interfere, so this is worth warning about.
other_live_envs() {
  local mine=$1 name port
  while read -r name; do
    [[ -n $name && $name != "$mine" ]] || continue
    port="$(env_port_base "$name")"
    if [[ -n "$(env_live_count "$name")" ]] && ((  $(env_live_count "$name") > 0 )); then
      printf '%s\n' "$name"
    elif port_listening "$port"; then
      printf '%s\n' "$name"
    fi
  done < <(env_names)
}

session_name_for() {
  local repo=$1 path=$2 name
  if [[ $path == "$repo" ]]; then
    name="$(basename "$repo")"
  else
    name="$(basename "$repo")/$(basename "$path")"
  fi
  printf '%s' "${name//[.:]/_}"
}

# Create the session if it is missing, and give it the env either way. One
# place only, so the run path and the open path cannot drift apart.
has_window() {
  tmux list-windows -t "=$1" -F '#{window_name}' 2>/dev/null | grep -qxF "$2"
}

ensure_session() {
  local name=$1 path=$2 repo=$3 envname w
  envname="$(env_of_path "$path")" || envname=""
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$path" -n editor \
      "${TW_EDITOR:-${EDITOR:-vi}}; exec $SHELL"
    # Before the other windows exist, so they inherit it.
    [[ -n $envname ]] && apply_env "$name" "$envname" "$(basename "$repo")" "$path"
  elif [[ -n $envname ]]; then
    apply_env "$name" "$envname" "$(basename "$repo")" "$path"
  fi
  # Also for a session that already exists: a window whose process exits is
  # closed by tmux, so server can be missing from a session that once had it.
  for w in server shell; do
    has_window "$name" "$w" || tmux new-window -d -t "=$name:" -c "$path" -n "$w"
  done
  tmux select-window -t "=$name:editor" 2>/dev/null
}

open_session() {
  local repo=$1 path=$2 name
  [[ -d $path ]] || {
    printf 'worktree directory is gone: %s\n' "$path"
    pause
    return 1
  }

  name="$(sessions_at "$path" | head -1)"
  [[ -n $name ]] || name="$(session_name_for "$repo" "$path")"
  ensure_session "$name" "$path" "$repo"

  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach-session -t "=$name"
  fi
}

# Is that window running something other than a shell? A dead pane keeps
# reporting the command it used to run, so check that first or a stopped
# process looks like it is still going and the toggle can never start again.
window_busy() {
  local session=$1 window=$2 line cmd dead
  line="$(tmux list-panes -t "=$session:$window" -F "#{pane_current_command}${TAB}#{pane_dead}" 2>/dev/null | head -1)"
  [[ -n $line ]] || return 1
  cmd="${line%%${TAB}*}"
  dead="${line##*${TAB}}"
  [[ $dead == 1 ]] && return 1
  [[ -n $cmd && $cmd != "$(basename "$SHELL")" && $cmd != fish && $cmd != bash && $cmd != zsh ]]
}

# The command for the server window: foreman over the Procfile when there is
# one, otherwise the single run script. Everything lands in one window --
# foreman prefixes each line with the process name, which beats hunting through
# a window per process.
#
# -e loads the env file (foreman's own mechanism, so no wrapper needed) and -p
# sets the base port, because foreman assigns PORT per process itself and would
# otherwise override the one the env picked. The processes that do not listen
# get ports above the block, which is harmless since they ignore them.
run_command() {
  local path=$1 port=$2 procfile script args inner
  if procfile="$(procfile_for "$path")"; then
    args="start -f $procfile"
    [[ -f "$path/.env.worktree" ]] && args="$args -e .env.worktree"
    [[ -n $port ]] && args="$args -p $port"
    printf 'exec foreman %s' "$args"
    return 0
  fi
  script="$(run_script "$path")" || return 1
  # A POSIX command, handed to sh explicitly rather than trusted to whatever
  # tmux's default-shell happens to be. A fish default-shell (a common choice,
  # and this tool's own README example) cannot parse "VAR=value" lines when
  # sourcing .env.worktree -- it prints a parse error and gives up on the file
  # entirely. tmux's own session environment (see apply_env) covers for it
  # when the command runs in a tmux pane, which is why this was easy to miss,
  # but a plain "./bin/run.sh" by hand in a fish shell would silently run
  # without the env. `exec sh -c '...'` still hands off the process directly,
  # so remain-on-exit and job tracking are unaffected either way.
  inner="set -a; [ -f ./.env.worktree ] && . ./.env.worktree; set +a; exec $(shquote "$script")"
  printf 'exec sh -c %s' "$(shquote "$inner")"
}

# Single-quote a string for safe reinjection into a shell command line, in a
# way that is the same idiom in POSIX sh, bash, zsh and fish alike: close the
# quote, escaped literal quote, reopen the quote.
shquote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# What to call it when reporting.
run_label() {
  local path=$1 procfile
  if procfile="$(procfile_for "$path")"; then
    printf '%s (%s)' "$procfile" "$(procfile_entries "$path/$procfile" | cut -f1 | paste -sd, -)"
  else
    basename "$(run_script "$path")"
  fi
}

# Start the repo run script in the session's server window, or stop it if it is
# already going.
do_run_toggle() {
  local kind=${1:-} repo=${2:-} path=${3:-} session envname script others port
  case $kind in
  wt | repo) ;;
  *)
    printf 'pick a worktree or repo row to run.\n'
    pause
    return 0
    ;;
  esac
  [[ -d $path ]] || {
    printf 'nothing at %s\n' "$path"
    pause
    return 0
  }

  if ! run_command "$path" "" >/dev/null; then
    printf 'no Procfile.dev, bin/debug.sh, bin/run.sh or bin/dev.sh in %s.\n' \
      "$(basename "$path")"
    pause
    return 0
  fi

  session="$(sessions_at "$path" | head -1)"
  [[ -n $session ]] || session="$(session_name_for "$repo" "$path")"

  # foreman passes the interrupt on to its children.
  if window_busy "$session" server; then
    tmux send-keys -t "=$session:server" C-c
    printf 'stopped %s in %s\n' "$(run_label "$path")" "$session"
    return 0
  fi

  # Something can hold the port without this tool having started it -- a
  # process launched from a plain shell, or a leftover from a crash. Starting on
  # top of it just fails with EADDRINUSE, so say who has it instead.
  if envname="$(env_of_path "$path")"; then
    port="$(service_port "$envname" "$(basename "$repo")")" || port=""
    if [[ -n $port ]] && port_listening "$port"; then
      printf 'port %s is already taken, and not by this session:\n' "$port"
      lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sed 's/^/  /' | head -4
      printf 'stop that first, then press it again.\n'
      pause
      return 0
    fi
  fi

  if envname="$(env_of_path "$path")"; then
    # Two running envs share redis, mysql and elasticsearch. Cross-talk there
    # is silent, so say so before adding a second one.
    others="$(other_live_envs "$envname" | paste -sd, -)"
    if [[ -n $others ]]; then
      printf 'These envs already look alive: %s\n' "$others"
      printf 'They share redis, mysql and elasticsearch with this one.\n'
      read -rp "start anyway? [y/N] " answer || return 0
      [[ $answer == [yY]* ]] || return 0
    fi
    port="$(service_port "$envname" "$(basename "$repo")")" || port=""
  fi
  ensure_session "$session" "$path" "$repo"

  local cmd
  cmd="$(run_command "$path" "$port")"
  if has_window "$session" server; then
    tmux respawn-window -k -t "=$session:server" -c "$path" "$cmd" || return 1
  else
    tmux new-window -d -t "=$session:" -n server -c "$path" "$cmd" || return 1
  fi
  # Keep the window when the command dies, or a failed start closes it and takes
  # the error with it -- which looks just like nothing having happened.
  tmux set-option -t "=$session:server" remain-on-exit on 2>/dev/null
  printf 'started %s in %s%s\n' "$(run_label "$path")" "$session" \
    "${port:+ on port $port}"
}

# ---------------------------------------------------------------- create

branch_choices() {
  local repo=$1
  {
    git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null
    comm -23 \
      <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/remotes 2>/dev/null |
        sed 's|^[^/]*/||' | grep -v '^HEAD$' | sort -u) \
      <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null | sort -u) |
      sed 's|^|remote: |'
  } | grep -v '^$'
}

create_worktree() {
  local repo=$1 rname base branch name path defbranch remote_ref out
  rname="$(basename "$repo")"
  defbranch="$(default_branch "$repo")"

  if [[ -z ${TW_NO_FETCH:-} ]]; then
    printf 'fetching %s...\n' "$rname"
    git -C "$repo" fetch --quiet --prune 2>/dev/null
  fi

  base="$(
    {
      printf 'new branch from %s\n' "$defbranch"
      branch_choices "$repo"
    } | fzf --reverse --prompt="base for new worktree in $rname> " --height='100%'
  )" || return 0
  [[ -n $base ]] || return 0

  if [[ $base == "new branch from "* ]]; then
    branch="$(prompt_default "new branch name> " "${TW_BRANCH_PREFIX:-}")" || return 0
    [[ -n $branch ]] || return 0
    branch="$(sanitize_branch "$branch")"
    if [[ -z $branch ]] || ! git check-ref-format "refs/heads/$branch" 2>/dev/null; then
      printf 'git will not accept that as a branch name: %s\n' "$branch"
      pause
      return 1
    fi
    name="$(slug "$branch")"
    path="$TW_ROOT/$rname/$name"
    [[ -e $path ]] && {
      printf 'already exists: %s\n' "$path"
      pause
      return 1
    }
    mkdir -p "$(dirname "$path")"
    # --no-track, or git points the new branch's upstream at the base branch
    # and the status column would call it "pushed" before it ever is.
    if ! out="$(git -C "$repo" worktree add --no-track -b "$branch" "$path" "$defbranch" 2>&1)"; then
      printf '%s\n' "$out"
      pause
      return 1
    fi
  else
    branch="${base#remote: }"
    name="$(prompt_default "worktree name> " "$(slug "$branch")")" || return 0
    name="$(slug "$name")"
    [[ -n $name ]] || return 0
    path="$TW_ROOT/$rname/$name"
    [[ -e $path ]] && {
      printf 'already exists: %s\n' "$path"
      pause
      return 1
    }
    mkdir -p "$(dirname "$path")"
    if git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
      out="$(git -C "$repo" worktree add "$path" "$branch" 2>&1)" || {
        printf '%s\n' "$out"
        pause
        return 1
      }
    else
      remote_ref="$(git -C "$repo" for-each-ref --format='%(refname:short)' \
        "refs/remotes/*/$branch" 2>/dev/null | head -1)"
      [[ -n $remote_ref ]] || remote_ref="origin/$branch"
      out="$(git -C "$repo" worktree add --track -b "$branch" "$path" "$remote_ref" 2>&1)" || {
        printf '%s\n' "$out"
        pause
        return 1
      }
    fi
  fi

  printf 'created %s\n' "$path"

  # Setup hooks, repo first, run where they can be watched since installing
  # dependencies takes a while. Looked up against the worktree: the branch
  # decides which scripts exist, and the worktree is where they run.
  #
  # Given the env's own facts (CTM_WT_ENV and friends), same as do_remove gives
  # teardown -- a setup hook deciding what to provision needs to know which env
  # it is provisioning for just as much as teardown needs to know what to undo.
  local setup envname
  envname="$(env_of_path "$path")" || envname=""
  while read -r setup; do
    [[ -n $setup ]] || continue
    printf 'running %s in the new worktree...\n\n' "$setup"
    (
      cd "$path" || exit 1
      if [[ -n $envname ]]; then
        set -a
        eval "$(env_exports "$envname" "$(basename "$repo")")"
        set +a
      fi
      "$setup"
    ) || {
      printf '\n%s failed. The worktree is there; fix it and re-run.\n' "$setup"
      pause
    }
  done < <(hooks_for "$path" setup)

  # Start it now if there is anything to start, rather than making ctrl-space
  # the very next keystroke after setup already took a while. Silently skipped
  # for a repo with no Procfile or run script -- do_run_toggle's own checks
  # (a port already taken, another live env sharing infra) still apply, since
  # those are real enough to ask about even right after creating a worktree.
  run_command "$path" "" >/dev/null 2>&1 && do_run_toggle wt "$repo" "$path"

  refresh_manifest_hook
  open_session "$repo" "$path"
}

# ---------------------------------------------------------------- remove

do_remove() {
  local kind=${1:-} repo=${2:-} path=${3:-} branch=${4:-} main answer out changed locked teardown

  # An env row's own field 2 is the env name, not a repo -- tear down every
  # worktree in it, rather than making you drill in and ctrl-x each one.
  if [[ $kind == env ]]; then
    do_remove_env "$repo"
    return
  fi

  if [[ $kind != wt ]]; then
    printf 'nothing to remove here -- pick a worktree line (this is a "%s" line).\n' "${kind:-blank}"
    pause
    return 0
  fi

  main="$(main_worktree "$repo")"
  if [[ $path == "$main" ]]; then
    printf 'refusing to remove the main checkout: %s\n' "$path"
    pause
    return 0
  fi

  changed="$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  locked="$(lock_reason "$repo" "$path")"
  printf 'remove worktree\n'
  printf '  path    %s\n' "$path"
  printf '  branch  %s\n' "${branch:-(detached)}"
  printf '  dirty   %s file(s)\n' "$changed"
  printf '  session %s\n' "$(sessions_at "$path" | paste -sd, - || true)"
  [[ -n $locked ]] && printf '  locked  %s\n' "$locked"
  # Only worktrees under the worktree root are envs with anything provisioned,
  # so only they get a teardown -- an agent worktree must never set it off.
  if env_of_path "$path" >/dev/null 2>&1 && teardown="$(hooks_for "$repo" teardown | tail -r | paste -sd, -)"; then
    printf '  teardown runs after removal: %s\n' "$(hooks_for "$repo" teardown | xargs -n1 basename | paste -sd, -)"
  else
    teardown=""
  fi
  printf 'the branch itself is kept.\n'
  read -rp "remove it? [y/N] " answer || return 0
  [[ $answer == [yY]* ]] || return 0

  if ! out="$(git -C "$repo" worktree remove "$path" 2>&1)"; then
    printf '%s\n' "$out"
    read -rp "force removal (throws away changes, ignores the lock)? [y/N] " answer || return 0
    [[ $answer == [yY]* ]] || return 0
    # Twice: git wants a second --force before it will touch a locked worktree.
    if ! out="$(git -C "$repo" worktree remove --force --force "$path" 2>&1)"; then
      printf '%s\n' "$out"
      pause
      return 1
    fi
  fi
  git -C "$repo" worktree prune 2>/dev/null

  kill_sessions_at "$path" >/dev/null

  rmdir "$(dirname "$path")" 2>/dev/null
  printf 'removed %s\n' "$path"

  # Opt in, not automatic: the worktree going away is routine, but throwing
  # out a branch (and its commits, if it is not merged anywhere) is not.
  if [[ -n $branch && $branch != "(detached)" ]]; then
    read -rp "delete branch '$branch' too? [y/N] " answer
    if [[ ${answer:-} == [yY]* ]]; then
      if out="$(git -C "$repo" branch -d "$branch" 2>&1)"; then
        printf 'deleted branch %s\n' "$branch"
      else
        printf '%s\n' "$out"
        read -rp "force delete (throws away commits not merged anywhere)? [y/N] " answer
        if [[ ${answer:-} == [yY]* ]]; then
          if out="$(git -C "$repo" branch -D "$branch" 2>&1)"; then
            printf 'deleted branch %s\n' "$branch"
          else
            printf '%s\n' "$out"
          fi
        fi
      fi
    fi
  fi

  # Only now that the worktree is really gone: undo what the repo provisioned
  # for this env, such as dropping its own database. Run from the main checkout,
  # because the copy inside the worktree went with it, and given the env
  # explicitly rather than from a file that no longer exists. Skipped entirely
  # for anything that is not an env worktree, so agent worktrees never trigger
  # somebody else's cleanup.
  local envname hook
  if [[ -n $teardown ]] && envname="$(env_of_path "$path")"; then
    printf '\n'
    # Reverse of setup: whatever the machine added comes off before the repo's
    # own teardown runs.
    while IFS= read -r hook; do
      [[ -n $hook ]] || continue
      (
        cd "$repo" || exit 1
        set -a
        eval "$(env_exports "$envname" "$(basename "$repo")")"
        set +a
        "$hook"
      ) || printf '%s failed; the worktree is already gone.\n' "$(basename "$hook")"
    done < <(hooks_for "$repo" teardown | tail -r)
  fi

  refresh_manifest_hook
}

# Every worktree in an env, torn down together. One combined confirmation up
# front (with each member's dirty/lock state shown, same as a single removal
# would show) stands in for the per-worktree ones do_remove asks on its own --
# asking that many times over is exactly the chore this exists to skip.
do_remove_env() {
  local name=$1 repo path branch changed locked answer out envname hook teardown
  local -a repos=() paths=() branches=()

  while read -r repo; do
    [[ -n $repo ]] || continue
    path="$(env_worktree "$repo" "$name")"
    [[ -d $path ]] || continue
    repos+=("$repo")
    paths+=("$path")
  done < <(env_repos "$name")

  if ((${#paths[@]} == 0)); then
    printf 'nothing to remove: no worktrees found for env %s\n' "$name"
    pause
    return 0
  fi

  printf 'remove env %s (%d worktree(s))\n' "$name" "${#paths[@]}"
  local i repo_path
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"
    repo_path="$(repo_path_for "${repos[$i]}")"
    branch="$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null)"
    [[ -n $branch ]] || branch="(detached)"
    branches[i]="$branch"
    changed="$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    locked="$([[ -n $repo_path ]] && lock_reason "$repo_path" "$path")"
    printf '  %-14s %s\n' "${repos[$i]}" "$path"
    printf '                 branch %-20s dirty %s file(s)%s\n' \
      "$branch" "$changed" "${locked:+   locked: $locked}"
  done
  printf 'sessions close and teardown hooks run for each. branches are kept, asked separately below.\n'
  read -rp "remove all ${#paths[@]}? [y/N] " answer || return 0
  [[ $answer == [yY]* ]] || return 0

  local removed=0
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"
    repo="${repos[$i]}"
    repo_path="$(repo_path_for "$repo")"
    if [[ -z $repo_path ]]; then
      printf '  %s: could not resolve the repo, skipped\n' "$repo"
      continue
    fi

    teardown="$(hooks_for "$repo_path" teardown | tail -r | paste -sd, -)"

    # Already agreed above, dirty/locked included, to remove everything shown --
    # a second force prompt per worktree here would be the exact tedium this
    # command exists to avoid.
    if ! out="$(git -C "$repo_path" worktree remove "$path" 2>&1)"; then
      if ! out="$(git -C "$repo_path" worktree remove --force --force "$path" 2>&1)"; then
        printf '  %s: %s\n' "$repo" "$out"
        continue
      fi
    fi
    git -C "$repo_path" worktree prune 2>/dev/null
    kill_sessions_at "$path" >/dev/null
    rmdir "$(dirname "$path")" 2>/dev/null
    printf '  removed %s\n' "$path"
    removed=$((removed + 1))

    if [[ -n $teardown ]] && envname="$(env_of_path "$path")"; then
      while IFS= read -r hook; do
        [[ -n $hook ]] || continue
        (
          cd "$repo_path" || exit 1
          set -a
          eval "$(env_exports "$envname" "$repo")"
          set +a
          "$hook"
        ) || printf '    %s failed; the worktree is already gone.\n' "$(basename "$hook")"
      done < <(hooks_for "$repo_path" teardown | tail -r)
    fi
  done
  printf 'removed %d of %d worktree(s) for env %s\n' "$removed" "${#paths[@]}" "$name"

  # One combined question for every branch, not one per worktree. Only ever
  # a safe -d here -- an unmerged branch is left for you to force by hand,
  # since silently discarding commits in a batch is a different order of
  # risk than routine worktree cleanup.
  local -a to_delete=()
  for i in "${!paths[@]}"; do
    [[ ${branches[$i]} != "(detached)" ]] && to_delete+=("$i")
  done
  if ((${#to_delete[@]} > 0)); then
    printf 'branches: %s\n' "$(for i in "${to_delete[@]}"; do printf '%s/%s ' "${repos[$i]}" "${branches[$i]}"; done)"
    read -rp "delete these branches too, where already merged? [y/N] " answer
    if [[ ${answer:-} == [yY]* ]]; then
      for i in "${to_delete[@]}"; do
        repo="${repos[$i]}"
        branch="${branches[$i]}"
        repo_path="$(repo_path_for "$repo")"
        [[ -n $repo_path ]] || continue
        if out="$(git -C "$repo_path" branch -d "$branch" 2>&1)"; then
          printf '  deleted %s/%s\n' "$repo" "$branch"
        else
          printf '  %s/%s: not deleted (not merged) -- remove it yourself if you are sure\n' "$repo" "$branch"
        fi
      done
    fi
  fi

  refresh_manifest_hook
}

# Close the tmux session for a worktree, nothing else -- the worktree and its
# branch are untouched, unlike ctrl-x. No confirmation, to stay as quick as
# ctrl-space; the only thing at risk is unsaved state in a pane (an nvim
# buffer, mainly), same as closing any terminal window.
do_kill_session() {
  local kind=${1:-} path=${3:-} killed
  case $kind in
  wt | repo) ;;
  *)
    printf 'pick a worktree or repo row to close its session.\n'
    pause
    return 0
    ;;
  esac
  killed="$(kill_sessions_at "$path")"
  if [[ -n $killed ]]; then
    printf 'closed session: %s\n' "$(printf '%s' "$killed" | paste -sd, -)"
  else
    printf 'no session was open for %s\n' "$path"
    pause
  fi
}

# ---------------------------------------------------------------- ui

usage() {
  sed -n '2,/^set -uo/p' "$SELF" | sed -e 's/^# \{0,1\}//' -e '/^set -uo/d'
}

main_ui() {
  local line kind repo path backtick row_bg match
  command -v fzf >/dev/null 2>&1 || die "fzf is not installed"
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"

  refresh_prs_in_background

  mkdir -p "$CACHE_DIR"
  view_write repos ""
  backtick="$(printf '\140')"

  if [[ "$(appearance)" == dark ]]; then
    row_bg=237
    match=cyan
  else
    row_bg=254
    match=blue
  fi

  line="$(
    do_view_list | fzf \
      --ansi \
      --delimiter="$TAB" \
      --with-nth=6 \
      --reverse \
      --no-sort \
      --height='100%' \
      --prompt='repos> ' \
      --info=inline \
      --highlight-line \
      --pointer='>' \
      --scrollbar='|' \
      --ellipsis='>' \
      --color="bg+:$row_bg,fg+:-1:bold,hl:$match:bold,hl+:$match:bold" \
      --color='pointer:blue,prompt:blue:bold,gutter:-1' \
      --color='info:bright-black,header:bright-black,separator:bright-black' \
      --color='border:bright-black,scrollbar:bright-black,query:-1:bold' \
      --header='enter open   ` repos/worktrees/envs   ctrl-t new   ctrl-x remove   ctrl-d close session   ctrl-r prs   ctrl-s fetch   ctrl-o browser' \
      --preview "$SELF --preview {1} {2} {3} {4}" \
      --preview-window='right,50%,border-left,wrap' \
      --preview-label=' details ' \
      --color='preview-border:bright-black,preview-label:bold' \
      --bind "ctrl-x:execute($SELF --remove {1} {2} {3} {4})+reload($SELF --view-list)" \
      --bind "ctrl-d:execute($SELF --kill-session {1} {2} {3})+reload($SELF --view-list)" \
      --bind "ctrl-r:execute($SELF --refresh {2})+reload($SELF --view-list)" \
      --bind "ctrl-s:execute($SELF --fetch {2})+reload($SELF --view-list)" \
      --bind "ctrl-o:execute-silent($SELF --open-url {5})" \
      --bind "$backtick:transform:$SELF --view-toggle" \
      --bind "bspace:transform:$SELF --view-back {q}" \
      --bind "ctrl-t:become($SELF --new {2})" \
      --bind "ctrl-space:execute($SELF --run {1} {2} {3})+reload($SELF --view-list)" \
      --bind "enter:transform:$SELF --view-enter {1} {2}" \
      --bind "tab:transform:$SELF --jump next {*1}" \
      --bind "btab:transform:$SELF --jump prev {*1}"
  )" || return 0
  [[ -n $line ]] || return 0

  IFS="$TAB" read -r kind repo path _ <<<"$line"
  case $kind in
  repo | wt) open_session "$repo" "$path" ;;
  new) create_worktree "$repo" ;;
  *) return 0 ;;
  esac
}

case "${1:-}" in
--list) list_all ;;
--preview)
  shift
  do_preview "$@"
  ;;
--remove)
  shift
  do_remove "$@"
  ;;
--kill-session)
  shift
  do_kill_session "$@"
  ;;
--new)
  shift
  if [[ -n ${1:-} && ! -d $1 ]]; then
    printf 'pick a repo or a worktree row first -- "%s" is not a directory.\n' "$1"
    pause
    exit 0
  fi
  repo="$(repo_of "${1:-$PWD}")" || die "not inside a git repository"
  create_worktree "$repo"
  ;;
--refresh)
  shift
  [[ -n ${1:-} ]] || exit 0
  printf 'refreshing pull requests for %s...\n' "$(basename "$1")"
  refresh_prs "$1"
  ;;
--view-list) do_view_list ;;
--manifest) write_manifest ;;
--env-exports)
  shift
  [[ -n ${1:-} ]] || die "usage: --env-exports <env> [repo]"
  env_exports "$@"
  ;;
--run)
  shift
  do_run_toggle "$@"
  ;;
--view-toggle) do_view_toggle ;;
--view-back)
  shift
  do_view_back "$@"
  ;;
--view-enter)
  shift
  do_view_enter "$@"
  ;;
--jump)
  shift
  do_jump "$@"
  ;;
--open-url)
  shift
  [[ -n ${1:-} ]] || exit 0
  open "$1"
  ;;
--fetch)
  shift
  [[ -n ${1:-} ]] || exit 0
  printf 'fetching %s...\n' "$(basename "$1")"
  git -C "$1" fetch --prune
  ;;
-h | --help) usage ;;
'') main_ui ;;
*) die "unknown argument: $1" ;;
esac
