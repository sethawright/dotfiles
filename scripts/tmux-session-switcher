#!/usr/bin/env bash
# Switch to an existing tmux session, here or on any Tailscale peer. Bound to
# M-, and meant to look like the M-/ picker (tmux-sessionizer) next to it,
# which is why the fzf options here are the same ones rather than fzf's
# defaults.
#
# This was an inline pipeline in tmux.conf; it is a file so it can share the
# palette, and so the light/dark choice happens per invocation rather than
# being frozen into the config.

lib="$(dirname "${BASH_SOURCE[0]}")/lib"
# shellcheck source=lib/tmux-remote.sh
. "$lib/tmux-remote.sh"

colors=""
if [[ -r $lib/fzf-theme.sh ]]; then
  # shellcheck source=lib/fzf-theme.sh
  . "$lib/fzf-theme.sh"
  colors="$(fzf_theme_colors)"
fi

# popup- sessions are the throwaway ones display-popup makes for these very
# pickers, so switching to one is never what anybody means.
#
# The local sessions come first and show at once; each peer's are added as
# it answers. fflush so awk passes rows on as they come instead of holding
# them all until the slowest peer is done.
list_sessions() {
  {
    tmux list-sessions -F "local	#{session_name}" 2>/dev/null
    each_peer <<<"tmux list-sessions -F '#{session_name}'"
  } | awk -F'\t' '$2 !~ /^popup-/ { printf "%-10s %s\n", $1, $2; fflush() }'
}

# Fed from a process substitution rather than a pipe, because bash waits for
# every process in a pipeline: picking a local session would otherwise sit
# there until the last peer answered or timed out.
selected="$(
  fzf --reverse --prompt='session> ' --info=inline --pointer='>' \
    --height='100%' ${colors:+--color="$colors"} < <(list_sessions)
)" || exit 0

[[ -n $selected ]] || exit 0
host="${selected%% *}"
session="$(sed -E 's/^[^ ]+ +//' <<<"$selected")"

if [[ $host == local ]]; then
  tmux switch-client -t "$session"
else
  attach_remote "$host" "$session"
fi
